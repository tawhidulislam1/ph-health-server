{
    "version": 2,
    "installCommand": "pnpm install --shamefully-hoist",
    "builds": [{
        "src": "api/index.ts",
        "use": "@vercel/node",
        "config": {
            "includeFiles": [
                "src/app/templates/**",
                "node_modules/**"
            ]
        }
    }],
    "routes": [{
        "src": "/(.*)",
        "dest": "api/index.ts"
    }]
}